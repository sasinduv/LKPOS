<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.pos.controller.SalesController"
            style="-fx-background-color: linear-gradient(to bottom right, #141E30, #243B55);">

    <VBox spacing="15"
          alignment="CENTER"
          prefWidth="450"
          style="-fx-background-color: white; -fx-background-radius: 15;"
          AnchorPane.topAnchor="40"
          AnchorPane.leftAnchor="200"
          AnchorPane.rightAnchor="200">

        <padding>
            <Insets top="25" bottom="25" left="30" right="30"/>
        </padding>

        <Label text="Sales &amp; Billing"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <!-- Product Selection -->
        <ComboBox fx:id="cmbProduct"
                  promptText="Select Product"
                  prefHeight="40"
                  prefWidth="300"/>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="txtPrice"
                       promptText="Price"
                       editable="false"
                       prefHeight="40"
                       prefWidth="145"/>
            <TextField fx:id="txtQty"
                       promptText="Quantity"
                       prefHeight="40"
                       prefWidth="145"/>
        </HBox>

        <Button text="Add to Bill"
                prefHeight="40"
                prefWidth="300"
                onAction="#addItem"
                style="
                    -fx-background-color: #4CAF50;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- Bill Table -->
        <TableView fx:id="tblBill"
                   prefHeight="220"
                   prefWidth="350"
                   style="-fx-border-radius: 8;"/>

        <!-- Totals -->
        <Label fx:id="lblTotal"
               text="Total: 0.00"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="txtCash"
                       promptText="Cash Given"
                       prefHeight="40"
                       prefWidth="170"/>
            <Label fx:id="lblBalance"
                   text="Balance: 0.00"
                   style="-fx-font-size: 14px;"/>
        </HBox>

        <ComboBox fx:id="cmbPayment"
                  promptText="Payment Method"
                  prefHeight="40"
                  prefWidth="300"/>

        <Button text="Complete Sale &amp; Download Bill"
                prefHeight="42"
                prefWidth="300"
                onAction="#completeSale"
                style="
                    -fx-background-color: #FF9800;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

    </VBox>

</AnchorPane>
