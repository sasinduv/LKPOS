<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.pos.controller.DashboardController"
            style="-fx-background-color: linear-gradient(to bottom right, #232526, #414345);">

    <VBox spacing="18"
          alignment="CENTER"
          prefWidth="400"
          style="-fx-background-color: white; -fx-background-radius: 15;"
          AnchorPane.topAnchor="80"
          AnchorPane.leftAnchor="200"
          AnchorPane.rightAnchor="200">

        <padding>
            <Insets top="30" bottom="30" left="30" right="30"/>
        </padding>

        <Label fx:id="lblWelcome"
               text="Welcome"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Button fx:id="btnProduct"
                text="Product Management"
                prefHeight="40"
                prefWidth="280"
                onAction="#openProduct"
                style="
                    -fx-background-color: #4CAF50;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-background-radius: 8;
                "/>

        <Button fx:id="btnInventory"
                text="Inventory Management"
                prefHeight="40"
                prefWidth="280"
                style="
                    -fx-background-color: #2196F3;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-background-radius: 8;
                "/>

        <Button fx:id="btnSales"
                text="Sales &amp; Billing"
                prefHeight="40"
                prefWidth="280"
                onAction="#openSales"
                style="
                    -fx-background-color: #FF9800;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-background-radius: 8;
                "/>

        <Button fx:id="btnReports"
                text="Reports &amp; Analytics"
                prefHeight="40"
                prefWidth="280"
                onAction="#openReports"
                style="
                    -fx-background-color: #9C27B0;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-background-radius: 8;
                "/>

        <Separator prefWidth="280"/>

        <Button fx:id="btnLogout"
                text="Logout"
                prefHeight="35"
                prefWidth="280"
                onAction="#logout"
                style="
                    -fx-background-color: #f44336;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

    </VBox>

</AnchorPane>
